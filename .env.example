# =============================================================================
# Binge Intelligence — environment template
# Copy this file to .env and fill in your real values. Never commit .env.
# =============================================================================

# ---- Database ----
DATABASE_URL=postgresql://binge:binge_dev_pw@localhost:5433/binge_intelligence

# ---- LLM providers ----
# LLM_PROVIDER can be: "fallback" (default, uses the chain below),
#                     "groq", or "gemini" (single-provider mode)
LLM_PROVIDER=fallback

# Fallback chain — tried in order on any provider error.
# Format: "provider:model,provider:model,..."
# A blank model slot (e.g. "groq:") uses that provider's default.
LLM_FALLBACK_CHAIN=groq:,groq:llama-3.3-70b-versatile,gemini:

# Optional single-model override (only for groq/gemini modes, ignored by fallback)
LLM_MODEL=

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---- TMDB (catalog, posters, cast) ----
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_POSTER_SIZE=w500
TMDB_BACKDROP_SIZE=w1280

# ---- MinIO (object storage for posters, backdrops, cast photos, audit logs) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=binge-content-docs
MINIO_SECURE=false
# Public URL base — what browsers hit for images. Defaults to http://<MINIO_ENDPOINT>
MINIO_PUBLIC_BASE=http://localhost:9000

# ---- Agent toggles ----
JUDGE_ENABLED=1         # set to 0 to disable the per-tool LLM judge
POLICY_RAG_ENABLED=1    # set to 0 to disable policy injection into the system prompt

# ---- Embedding model ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
